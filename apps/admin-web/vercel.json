{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "corepack enable pnpm && cd ../.. && pnpm install",
  "buildCommand": "cd ../.. && pnpm run build --filter=admin-web",
  "outputDirectory": "apps/admin-web/.next",
  "framework": "nextjs",
  "env": {
    "NODE_ENV": "production",
    "PNPM_FLAGS": "--no-frozen-lockfile"
  }
}