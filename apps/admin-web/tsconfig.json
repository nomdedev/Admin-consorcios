{
  "extends": "@vecinosimple/typescript-config/nextjs.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@vecinosimple/api-client": ["../../packages/api-client/src"],
      "@vecinosimple/api-client/*": ["../../packages/api-client/src/*"],
      "ui": ["./src/ui"],
      "ui/*": ["./src/ui/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts", "src/test/**/*"],
  "exclude": ["node_modules", "vitest.config.ts", "playwright.config.ts", "src/test/**/*"]
}
