{
  "name": "vecinosimple",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "build:admin-web": "npm run --workspace=@vecinosimple/admin-web build",
    "build:resident-app": "npm run --workspace=@vecinosimple/resident-app build",
    "build:staff-app": "npm run --workspace=@vecinosimple/staff-app build",
    "build:api": "npm run --workspace=@vecinosimple/api build",
    "postinstall": "turbo run build --filter=@vecinosimple/database",
    "lint": "turbo lint",
    "lint:fix": "turbo lint:fix",
    "type-check": "turbo type-check",
    "test": "turbo test",
    "test:e2e": "turbo test:e2e",
    "clean": "turbo clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "db:generate": "turbo run build --filter=@vecinosimple/database",
    "db:migrate": "turbo run migrate:dev --filter=@vecinosimple/database",
    "db:push": "turbo run push --filter=@vecinosimple/database",
    "db:seed": "turbo run seed --filter=@vecinosimple/database",
    "db:studio": "turbo run studio --filter=@vecinosimple/database",
    "setup:prod": "./scripts/setup-production.sh",
    "deploy:db": "./scripts/deploy-db.sh",
    "smoke:test": "./scripts/smoke-test.sh",
    "rollback": "./scripts/rollback.sh",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.0.0",
    "lint-staged": "^15.2.0",
    "next": "^16.3.5",
    "prettier": "^3.2.0",
    "prettier-plugin-tailwindcss": "^0.5.11",
    "turbo": "^2.7.6"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  }
}
