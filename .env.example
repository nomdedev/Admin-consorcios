# =============================================================================
# VecinoSimple - Variables de Entorno (TEMPLATE)
# =============================================================================
# ⚠️  NUNCA commitear valores reales - Solo placeholders
# Copiar este archivo a .env.local y completar con valores reales

# -----------------------------------------------------------------------------
# Base de Datos (Railway PostgreSQL)
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://usuario:password@host:5432/vecinosimple?schema=public"

# -----------------------------------------------------------------------------
# 🔐 SEGURIDAD - JWT (REQUERIDO)
# -----------------------------------------------------------------------------
# IMPORTANTE: Generar con: node scripts/generate-secrets.js
JWT_SECRET="GENERATE_WITH_SCRIPT"

# -----------------------------------------------------------------------------
# 🔐 SEGURIDAD - ENCRIPTACIÓN DB (REQUERIDO)
# -----------------------------------------------------------------------------
# 32 bytes en base64. Ejemplo para generar:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DB_ENCRYPTION_KEY="GENERATE_WITH_SCRIPT"

# -----------------------------------------------------------------------------
# Autenticación (NextAuth.js / Magic Link)
# -----------------------------------------------------------------------------
NEXTAUTH_SECRET="GENERATE_WITH_SCRIPT"
NEXTAUTH_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# 🔐 SEGURIDAD - CORS (REQUERIDO en producción)
# -----------------------------------------------------------------------------
ALLOWED_ORIGINS="https://admin.vecinosimple.com,https://app.vecinosimple.com"

# -----------------------------------------------------------------------------
# Mercado Pago (Split Payments)
# -----------------------------------------------------------------------------
MERCADO_PAGO_ACCESS_TOKEN="YOUR_ACCESS_TOKEN"
MERCADO_PAGO_PUBLIC_KEY="YOUR_PUBLIC_KEY"
MERCADO_PAGO_WEBHOOK_SECRET="YOUR_WEBHOOK_SECRET"
MERCADO_PAGO_SPLIT_ENABLED="true"
MERCADO_PAGO_PLATFORM_FEE_PERCENT="2"
MERCADO_PAGO_COLLECTOR_ID="YOUR_COLLECTOR_ID"

# -----------------------------------------------------------------------------
# WhatsApp Business API (Meta Cloud API)
# -----------------------------------------------------------------------------
WHATSAPP_PHONE_NUMBER_ID="YOUR_PHONE_NUMBER_ID"
WHATSAPP_ACCESS_TOKEN="YOUR_ACCESS_TOKEN"
WHATSAPP_VERIFY_TOKEN="YOUR_VERIFY_TOKEN"
WHATSAPP_BUSINESS_ACCOUNT_ID="YOUR_BUSINESS_ACCOUNT_ID"
WHATSAPP_API_VERSION="v18.0"

# -----------------------------------------------------------------------------
# Firebase Cloud Messaging (Push Notifications)
# -----------------------------------------------------------------------------
FIREBASE_PROJECT_ID="YOUR_PROJECT_ID"
FIREBASE_PRIVATE_KEY="YOUR_PRIVATE_KEY"
FIREBASE_CLIENT_EMAIL="YOUR_CLIENT_EMAIL"

# -----------------------------------------------------------------------------
# AFIP (Facturación Electrónica)
# -----------------------------------------------------------------------------
AFIP_CUIT="YOUR_CUIT"
AFIP_CERT_PATH="./certs/afip.crt"
AFIP_KEY_PATH="./certs/afip.key"
AFIP_ENV="testing"

# -----------------------------------------------------------------------------
# Email (Resend)
# -----------------------------------------------------------------------------
RESEND_API_KEY="YOUR_API_KEY"
EMAIL_FROM="noreply@vecinosimple.com"
EMAIL_FROM_NAME="VecinoSimple"
APP_URL="https://vecinosimple.com"

# -----------------------------------------------------------------------------
# Sentry (Error tracking)
# -----------------------------------------------------------------------------
SENTRY_DSN=""
SENTRY_ENVIRONMENT="development"
SENTRY_RELEASE=""
SENTRY_TRACES_SAMPLE_RATE="0.0"
NEXT_PUBLIC_SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_ENVIRONMENT="development"
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE="0.0"

# -----------------------------------------------------------------------------
# Storage (AWS S3 / Cloudflare R2 / Supabase Storage)
# -----------------------------------------------------------------------------
S3_ACCESS_KEY_ID="YOUR_ACCESS_KEY"
S3_SECRET_ACCESS_KEY="YOUR_SECRET_KEY"
S3_BUCKET="vecinosimple"
S3_REGION="auto"
S3_ENDPOINT="YOUR_ENDPOINT"
S3_PUBLIC_URL="YOUR_PUBLIC_URL"

# -----------------------------------------------------------------------------
# Supabase Storage (PRIORIDAD sobre S3)
# -----------------------------------------------------------------------------
SUPABASE_URL="https://tu-proyecto.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SERVICE_ROLE_KEY"
SUPABASE_BUCKET="vecinosimple-uploads"
NEXT_PUBLIC_SUPABASE_URL="https://tu-proyecto.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR_ANON_KEY"

# -----------------------------------------------------------------------------
# Aplicación
# -----------------------------------------------------------------------------
NODE_ENV="development"
LOG_LEVEL="debug"
ADMIN_WEB_URL="http://localhost:3000"
RESIDENT_APP_URL="http://localhost:3001"
STAFF_APP_URL="http://localhost:3002"
API_URL="http://localhost:4000"
FRONTEND_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# JWT Configuración Adicional
# -----------------------------------------------------------------------------
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# -----------------------------------------------------------------------------
# Rate Limiting
# -----------------------------------------------------------------------------
THROTTLE_SHORT_TTL="1000"
THROTTLE_SHORT_LIMIT="10"
THROTTLE_MEDIUM_TTL="10000"
THROTTLE_MEDIUM_LIMIT="50"
THROTTLE_LONG_TTL="60000"
THROTTLE_LONG_LIMIT="200"

# -----------------------------------------------------------------------------
# Cache (Redis)
# -----------------------------------------------------------------------------
REDIS_URL="redis://localhost:6379"
CACHE_TTL_SECONDS="60"

# -----------------------------------------------------------------------------
# Queue (Bull)
# -----------------------------------------------------------------------------
QUEUE_EMAIL_ENABLED="true"
